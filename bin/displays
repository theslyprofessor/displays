#!/usr/bin/env python3
"""displays - CLI companion for ~/Applications/Displays.app.

Reads ~/.config/displays/presets.json (organized by machine/classroom folder:
84-101, 84-102, 84-105, etc.) and applies or lists displayplacer presets.

Usage:
  displays                         list all machine folders and presets
  displays list [folder]           list presets in a specific folder (e.g. 84-101)
  displays apply <folder> <match>  apply a preset by number or substring match
  displays open                    open Displays.app
"""
import json, os, subprocess, sys
from pathlib import Path

CONFIG = Path.home() / ".config/displays/presets.json"


def load_root():
    if not CONFIG.exists():
        sys.exit(f"Config not found at {CONFIG}. Launch ~/Applications/Displays.app first.")
    return json.loads(CONFIG.read_text())


def cmd_list(folder_filter=None):
    root = load_root()
    last_id = root.get("lastAppliedPresetID")
    for f in root.get("folders", []):
        if folder_filter and folder_filter.lower() not in f["name"].lower() and folder_filter.lower() not in f["id"].lower():
            continue
        print(f"📁 {f['name']} · {f.get('description', '')}")
        for i, p in enumerate(f.get("presets", []), 1):
            mark = "●" if p["id"] == last_id else " "
            print(f"  {mark} [{i}] {p['name']}")
            print(f"        {p.get('subtitle', '')}")
        print()


def cmd_apply(folder_query, preset_query):
    root = load_root()
    folder = None
    for f in root.get("folders", []):
        if folder_query.lower() in f["name"].lower() or folder_query.lower() in f["id"].lower():
            folder = f
            break
    if not folder:
        sys.exit(f"No folder matching {folder_query!r}")
    presets = folder.get("presets", [])
    chosen = None
    if preset_query.isdigit():
        idx = int(preset_query) - 1
        if 0 <= idx < len(presets):
            chosen = presets[idx]
    else:
        for p in presets:
            if preset_query.lower() in p["name"].lower() or preset_query.lower() in p["id"].lower():
                chosen = p
                break
    if not chosen:
        sys.exit(f"No preset matching {preset_query!r} in folder {folder['name']}")
    cmd = chosen["command"]
    print(f"Applying [{folder['name']}] {chosen['name']}...")
    rc = subprocess.call(cmd, shell=True)
    if rc == 0:
        root["lastAppliedPresetID"] = chosen["id"]
        root["selectedFolderID"] = folder["id"]
        CONFIG.write_text(json.dumps(root, indent=2))
    sys.exit(rc)


def main():
    args = sys.argv[1:]
    if not args or args[0] == "list":
        cmd_list(args[1] if len(args) > 1 else None)
    elif args[0] == "apply" and len(args) >= 3:
        cmd_apply(args[1], " ".join(args[2:]))
    elif args[0] == "open":
        subprocess.run(["open", str(Path.home() / "Applications/Displays.app")])
    else:
        print(__doc__.strip())


if __name__ == "__main__":
    main()
